# Solana RPC Configuration (comma-separated for ordered failover)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
AGENT_WALLET_ADDRESS=<YOUR_SOLANA_AGENT_WALLET_PUBKEY>

# Jupiter Swap v1 Quote API (free tier: lite-api.jup.ag, keyed tier: api.jup.ag)
JUPITER_QUOTE_API_URL=https://lite-api.jup.ag/swap/v1/quote
JUPITER_API_KEY=

# Ace Data Cloud (x402 conviction & market intelligence)
ACE_DATA_API_URL=https://api.acedata.cloud
ACE_DATA_API_KEY=

# Autonomous Risk Policy Controls
MAX_TRADE_ALLOCATION_BPS=2000
MAX_DAILY_DRAWDOWN_BPS=500
MAX_SLIPPAGE_BPS=50
MAX_PRICE_IMPACT_BPS=100
MAX_QUOTE_AGE_MS=15000
COOLDOWN_MS=30000
RPC_TIMEOUT_MS=8000
STATE_DIR=.agent-state
